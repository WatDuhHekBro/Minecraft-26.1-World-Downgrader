    VerticalBox {
        Text {
            text: "Minecraft 26.1 World Downgrader (to 1.21.11)";
        }

        Rectangle {
            background: #8f150a;

            Text {
                text: "Status:";
            }
            
            VerticalBox {
                TextEdit {
                    text: "\{root.status}";
                    read-only: true;
                }
            }
        }

        Button {
            text: "Downgrade a World";
            clicked => {
                root.execute-downgrade();
            }
        }
    }
}
