import { VerticalBox, Button, TextEdit } from "std-widgets.slint";

export component Main inherits Window {
    in property <string> args-title: "Minecraft 26.1 World Downgrader (Unknown Version)";
    title: args-title;
    width: 600px;
    height: 400px;

    in-out property <string> status: "Waiting for user...";
    callback execute-downgrade();

    /*in-out property <string> folder: "N/A";
    callback delete-folder-yes();
    callback delete-folder-no();

    callback show-popup();
    show-popup => {
        popup.show();
    }

    popup := PopupWindow {
